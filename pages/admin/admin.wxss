.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-card {
  margin-bottom: 0;
}

.stat-value {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.small-btn {
  width: 150rpx;
  padding: 0;
  margin: 0;
  font-size: 24rpx;
}

.list-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.list-row:last-child {
  border-bottom: 0;
}

.empty {
  margin-top: 20rpx;
}
