.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.record-tabs {
  display: flex;
}

.record-tabs button.record-tab[size="mini"] {
  flex: 1;
  width: auto;
  min-width: 0;
  padding: 0;
  margin: 0;
  color: #aaa7b2;
  background: #2a2a34;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.record-tabs button + button {
  margin-left: 12rpx;
}

.record-tabs button.record-tab.active {
  color: #20170a;
  background: #d6a354;
}

.stat-card {
  margin-bottom: 0;
}

.stat-value {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.small-btn {
  width: 150rpx;
  padding: 0;
  margin: 0;
  font-size: 24rpx;
}

.list-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.list-row:last-child {
  border-bottom: 0;
}

.empty {
  margin-top: 20rpx;
}

.table-grid {
  display: grid;
  gap: 16rpx;
  margin-top: 20rpx;
}

.table-card {
  padding: 20rpx;
  background: #17171d;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
}

.table-card.using {
  border-color: rgba(235, 90, 90, 0.55);
}

.table-name {
  font-size: 28rpx;
  font-weight: 700;
}

.tag {
  padding: 4rpx 10rpx;
  color: #8ed6a0;
  font-size: 20rpx;
  background: rgba(80, 180, 110, 0.12);
  border-radius: 999rpx;
}

.using .tag {
  color: #ff8a8a;
  background: rgba(235, 90, 90, 0.12);
}

.table-summary {
  margin-top: 14rpx;
  color: #aaa7b2;
  font-size: 22rpx;
}

.table-actions {
  margin-top: 12rpx;
}

.table-actions .small-btn {
  width: 100%;
  font-size: 21rpx;
}

.table-actions button.small-btn[size="mini"] {
  display: block;
  width: 100%;
  padding: 0;
  margin: 0;
  font-size: 24rpx;
  line-height: 64rpx;
}

.table-actions button.buy-button[size="mini"] {
  margin-top: 12rpx;
}

.checkout-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  background: rgba(0, 0, 0, 0.78);
}

.checkout-sheet {
  width: 100%;
  max-height: 90vh;
  padding: 28rpx;
  background: #1d1d25;
  border: 1rpx solid #403a31;
  border-radius: 24rpx;
}

.checkout-title {
  font-size: 38rpx;
  font-weight: 700;
}

.checkout-content {
  height: 42vh;
  margin-top: 20rpx;
}

.checkout-actions {
  display: flex;
  margin-top: 24rpx;
}

.checkout-actions button[size="mini"] {
  flex: 1;
  min-width: 0;
  padding: 0 8rpx;
  margin: 0;
  font-size: 24rpx;
  line-height: 80rpx;
}

.checkout-actions button + button {
  margin-left: 12rpx;
}

.detail-line,
.product-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  color: #aaa7b2;
}

.order-detail {
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.order-detail .row {
  font-size: 23rpx;
}

.product-line {
  padding: 10rpx 0 0;
  font-size: 22rpx;
}

.detail-total {
  padding: 20rpx 0;
  margin-top: 8rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 30rpx;
  font-weight: 700;
}

.detail-actions {
  display: flex;
  gap: 14rpx;
}

.detail-actions button {
  flex: 1;
  font-size: 23rpx;
}

.commission-panel {
  padding-top: 16rpx;
}

.special-assignment-section {
  margin-top: 18rpx;
}

.section-subtitle {
  font-size: 28rpx;
  font-weight: 700;
}

.allocation-card {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #101014;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.special-assignment-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 14rpx;
}

.special-action-btn {
  width: 160rpx;
  padding: 0;
  margin: 0;
  font-size: 22rpx;
}

.special-quantity-option {
  align-items: center;
}

.quantity-stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quantity-button {
  width: 72rpx;
  min-width: 72rpx;
  padding: 0;
  margin: 0;
  font-size: 28rpx;
  line-height: 64rpx;
}

.special-commission-line {
  margin-top: 8rpx;
  padding-left: 8rpx;
}

.special-commission-highlight {
  padding: 10rpx 14rpx;
  color: #f6d18b;
  background: rgba(214, 163, 84, 0.12);
  border-left: 4rpx solid #d6a354;
  border-radius: 12rpx;
}

.special-commission-summary {
  margin-top: 12rpx;
  color: #f0c77a;
}

.special-item-commission {
  display: inline-block;
  margin-top: 8rpx;
  padding: 6rpx 10rpx;
  color: #f6d18b;
  background: rgba(214, 163, 84, 0.12);
  border-radius: 10rpx;
}

.staff-option.unavailable {
  opacity: 0.45;
}

.staff-option-status.unavailable {
  color: #c8a870;
  background: rgba(214, 163, 84, 0.12);
}

.staff-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #101014;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.staff-option.selected {
  border-color: #d6a354;
  background: rgba(214, 163, 84, 0.1);
}

.staff-option-name {
  font-size: 30rpx;
  font-weight: 700;
}

.staff-option-status {
  min-width: 112rpx;
  padding: 8rpx 14rpx;
  color: #aaa7b2;
  text-align: center;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.staff-option-status.selected {
  color: #20170a;
  background: #d6a354;
}
