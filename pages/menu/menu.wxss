.category-tabs {
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  padding: 18rpx 28rpx;
  margin-right: 16rpx;
  color: #aaa7b2;
  background: #1d1d25;
  border-radius: 999rpx;
}

.tab.active {
  color: #20170a;
  background: #d6a354;
}

.product {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-name {
  font-size: 32rpx;
  font-weight: 700;
}

.counter {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.count-btn {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
  line-height: 64rpx;
}

.checkout-bar {
  position: sticky;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: rgba(29, 29, 37, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
}

.checkout-btn {
  width: 240rpx;
  margin: 0;
}
