<view class="page">
  <view wx:if="{{order}}" class="section bill">
    <view class="title">下单成功</view>
    <view class="subtitle">当前桌号：{{order.tableName}} · 下单时间：{{order.createdAtText}}</view>
    <view class="subtitle">订单已提交，管理端同步后可查看</view>
    <view class="divider"></view>

    <view wx:for="{{order.items}}" wx:key="productId" class="row item-row">
      <view>
        <view>{{item.name}}</view>
        <view class="subtitle">x {{item.quantity}}</view>
      </view>
      <text class="price">{{item.totalText}}</text>
    </view>

    <view class="divider"></view>
    <view class="row total">
      <text>本单商品金额</text>
      <text class="price">{{totalText}}</text>
    </view>
    <view class="subtitle">订单号：{{order.id}}</view>
  </view>

  <view wx:if="{{session}}" class="section">
    <view class="row"><text>已消费时长</text><text>{{session.elapsedText}}</text></view>
    <view class="row bill-line"><text>商品 / 小吃累计</text><text>{{session.itemTotalText}}</text></view>
    <view class="row bill-line"><text>时长服务费（动态计时）</text><text>{{session.serviceFeeText}}</text></view>
    <view class="row total">
      <text>当前累计金额</text>
      <text class="price">{{session.totalText}}</text>
    </view>
  </view>

  <button class="primary-button" disabled="{{!order}}" bindtap="continueOrdering">继续点单</button>
</view>
