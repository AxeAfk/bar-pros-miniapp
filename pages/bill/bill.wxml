<view class="page">
  <view wx:if="{{order}}" class="section bill">
    <view class="title">{{billTitle}}</view>
    <view class="subtitle">{{order.tableName}} · {{order.createdAtText}}</view>
    <view class="subtitle">{{billHint}}</view>
    <view class="divider"></view>

    <view wx:for="{{order.items}}" wx:key="productId" class="row item-row">
      <view>
        <view>{{item.name}}</view>
        <view class="subtitle">x {{item.quantity}}</view>
      </view>
      <text class="price">{{item.totalText}}</text>
    </view>

    <view class="divider"></view>
    <view class="row total">
      <text>合计</text>
      <text class="price">{{totalText}}</text>
    </view>
    <view class="subtitle">订单号：{{order.id}}</view>
    <view class="subtitle">订单状态：{{order.status === 'submitted' ? '已提交' : '已支付'}}</view>
  </view>

  <button class="primary-button" bindtap="backToTables">继续点单</button>
</view>
