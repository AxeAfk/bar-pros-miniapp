.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-btn {
  width: 150rpx;
  margin: 0;
  font-size: 26rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.table-card {
  padding: 26rpx;
  background: #1d1d25;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
}

.table-card.using {
  border-color: rgba(214, 163, 84, 0.65);
}

.table-name {
  font-size: 34rpx;
  font-weight: 700;
}

.tag {
  padding: 6rpx 14rpx;
  color: #d6a354;
  font-size: 22rpx;
  background: rgba(214, 163, 84, 0.13);
  border-radius: 999rpx;
}

button {
  margin-top: 26rpx;
  font-size: 26rpx;
}
