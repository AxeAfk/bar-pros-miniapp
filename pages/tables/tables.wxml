<view class="page">
  <view class="section hero">
    <view>
      <view class="title">{{shop.name}}</view>
      <view class="subtitle">扫码点单 · 在线支付 · 6桌首版</view>
    </view>
    <button class="secondary-button admin-btn" bindtap="goAdmin">管理</button>
  </view>

  <view class="grid">
    <view wx:for="{{tables}}" wx:key="id" class="table-card {{item.status}}" data-table-id="{{item.id}}" bindtap="selectTable">
      <view class="row">
        <text class="table-name">{{item.name}}</text>
        <text class="tag">{{item.statusText}}</text>
      </view>
      <view class="subtitle">{{item.area}} · {{item.id}}</view>
      <button class="primary-button">开始点单</button>
    </view>
  </view>
</view>
